# ══════════════════════════════════════════════════════════
#  SOAC RKU — Backend Environment Variables
#  Copy this file to .env and fill in all values.
#  Never commit .env to version control.
# ══════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── PostgreSQL ───────────────────────────────────────────
# OPTION A — Railway: paste the DATABASE_URL from your Railway PostgreSQL plugin
# DATABASE_URL=postgresql://user:password@host:5432/railway

# OPTION B — Local / manual: fill individual vars
PG_HOST=localhost
PG_PORT=5432
PG_DB=soac_rku
PG_USER=postgres
PG_PASSWORD=your-strong-db-password
PG_POOL_MAX=20
PG_IDLE_TIMEOUT=10000
PG_CONN_TIMEOUT=3000
PG_QUERY_TIMEOUT=30000
PG_RETRY_ATTEMPTS=5

# ── Redis ─────────────────────────────────────────────────
# OPTION A — Railway: paste the REDIS_URL from your Railway Redis plugin
# REDIS_URL=redis://:password@host:6379

# OPTION B — Local / manual
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # Only if Redis requires auth

# ── JWT (ALL REQUIRED — generate unique secrets) ────────
# Generate: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-different-long-random-secret-min-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d
RESET_PASSWORD_SECRET=replace-with-another-long-random-secret-min-32-chars
RESET_PASSWORD_EXPIRES_IN=30m

# ── Email / SMTP (optional — app runs without it) ────────
# OPTION A — Resend (RECOMMENDED for production / Railway)
#   Never blocked by cloud providers; free tier = 3 000 emails/month
#   1. Sign up at https://resend.com
#   2. Verify your sending domain under Domains (add the DNS records it gives you)
#   3. Create an API key → copy it below
#   4. In Railway: add RESEND_API_KEY and EMAIL_FROM in the Variables tab
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=SOAC <noreply@soac.info>

# OPTION B — Gmail fallback (used only when RESEND_API_KEY is not set)
#   Generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# ── Frontend URL (REQUIRED in production) ────────────────
# Your custom domain — no trailing slash
CLIENT_URL=https://soac.info

# ── Admin Email (REQUIRED in production) ─────────────────
ADMIN_EMAIL=admin@rku.ac.in

# ── External APIs (optional) ─────────────────────────────
NEWS_API_KEY=your-newsapi-key
YOUTUBE_API_KEY=your-youtube-api-key

# ── Push notifications — Firebase Cloud Messaging (optional) ─────
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key. Base64-encode the downloaded JSON before pasting it here
# (its private_key field has literal newlines that are easy to mangle
# through a plain env var UI):
#   node -e "console.log(require('fs').readFileSync('serviceAccount.json').toString('base64'))"
# Push stays inert (no errors) if this is unset.
FIREBASE_SERVICE_ACCOUNT=
