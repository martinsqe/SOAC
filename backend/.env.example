# ══════════════════════════════════════════════════════════
#  SOAC RKU — Backend Environment Variables
#  Copy this file to .env and fill in all values.
#  Never commit .env to version control.
# ══════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── PostgreSQL ───────────────────────────────────────────
# OPTION A — Railway: paste the DATABASE_URL from your Railway PostgreSQL plugin
# DATABASE_URL=postgresql://user:password@host:5432/railway

# OPTION B — Local / manual: fill individual vars
PG_HOST=localhost
PG_PORT=5432
PG_DB=soac_rku
PG_USER=postgres
PG_PASSWORD=your-strong-db-password
PG_POOL_MAX=20
PG_IDLE_TIMEOUT=10000
PG_CONN_TIMEOUT=3000
PG_QUERY_TIMEOUT=30000
PG_RETRY_ATTEMPTS=5

# ── Redis ─────────────────────────────────────────────────
# OPTION A — Railway: paste the REDIS_URL from your Railway Redis plugin
# REDIS_URL=redis://:password@host:6379

# OPTION B — Local / manual
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # Only if Redis requires auth

# ── JWT (ALL REQUIRED — generate unique secrets) ────────
# Generate: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-different-long-random-secret-min-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d
RESET_PASSWORD_SECRET=replace-with-another-long-random-secret-min-32-chars
RESET_PASSWORD_EXPIRES_IN=30m

# ── Email (optional — app runs without it) ──────────────
# Gmail API — sends from a Google Workspace account (e.g. soac@rku.ac.in)
# over HTTPS, so it works on Railway where SMTP is blocked.
#   1. Google Cloud Console (signed in as the sending account): create a project,
#      enable "Gmail API", set the OAuth consent screen to "Internal",
#      then Credentials → Create OAuth client ID → "Desktop app"
#   2. Fill GMAIL_USER, GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET below
#   3. Run `node scripts/gmail-auth.js` and paste the refresh token it prints
#   4. In Railway: add the same GMAIL_* and EMAIL_FROM in the Variables tab
GMAIL_USER=soac@rku.ac.in
GMAIL_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
GMAIL_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxx
EMAIL_FROM=SOAC RKU <soac@rku.ac.in>
# EMAIL_REPLY_TO=soac@rku.ac.in   # optional — defaults to the sending account

# Optional SMTP fallback (local dev only — Railway blocks SMTP)
#   Generate an App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=your-email@rku.ac.in
# SMTP_PASS=your-app-password

# ── Frontend URL (REQUIRED in production) ────────────────
# Your custom domain — no trailing slash
CLIENT_URL=https://soac.info

# ── Admin Email (REQUIRED in production) ─────────────────
ADMIN_EMAIL=admin@rku.ac.in

# ── External APIs (optional) ─────────────────────────────
NEWS_API_KEY=your-newsapi-key
YOUTUBE_API_KEY=your-youtube-api-key

# ── Push notifications — Firebase Cloud Messaging (optional) ─────
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key. Base64-encode the downloaded JSON before pasting it here
# (its private_key field has literal newlines that are easy to mangle
# through a plain env var UI):
#   node -e "console.log(require('fs').readFileSync('serviceAccount.json').toString('base64'))"
# Push stays inert (no errors) if this is unset.
FIREBASE_SERVICE_ACCOUNT=
