# Push notifications now run on Firebase Cloud Messaging — see src/firebase.js
# and src/firebaseMessaging.js. No env var needed here: Firebase's web config
# is safe to hardcode in source (same reasoning as a VAPID public key), so
# there's nothing frontend-build-time-specific left to configure.

# Google sign-in for the Join Club modal — the Firebase project owned by
# soac.notifications@rku.ac.in (Project settings → Your apps → Web app config).
# Leave empty to use the push-notification project in src/firebase.js.
VITE_GOOGLE_AUTH_API_KEY=
VITE_GOOGLE_AUTH_AUTH_DOMAIN=
VITE_GOOGLE_AUTH_PROJECT_ID=
VITE_GOOGLE_AUTH_APP_ID=
